# Copia este archivo a .env y completa los valores. .env nunca se sube a git
# (ver .gitignore) y jamás debe copiarse a README, logs ni fixtures de tests.

# --- Obligatoria ---
# Cadena de conexión de SQLAlchemy a PostgreSQL. El docker-compose.yml de este
# proyecto expone Postgres en localhost:5432 con estos valores por defecto.
DATABASE_URL=postgresql+psycopg://crypto:crypto@localhost:5432/crypto_trading

# --- Opcional: solo la usan los tests, nunca la aplicación en marcha ---
# Los tests de integración corren contra una base de datos SEPARADA de la
# real, para que nunca lean ni escriban sobre datos verdaderos (ver
# tests/conftest.py). Si dejas esto vacío, se deriva automáticamente de
# DATABASE_URL agregando "_test" al nombre de la base
# (crypto_trading -> crypto_trading_test) — no hace falta definir nada aquí
# en el caso normal. Descomenta y ajusta solo si necesitas una base de
# pruebas distinta (p. ej. en CI).
# TEST_DATABASE_URL=postgresql+psycopg://crypto:crypto@localhost:5432/crypto_trading_test

# --- Binance (no se usa todavía en este entregable — Fase 1 en adelante) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Anthropic (usada desde Paso 6 por app/ai/ — agentes 2/3/4) ---
# ADVERTENCIA (sección 11 del plan): si ANTHROPIC_API_KEY está definida como
# variable de entorno DEL SISTEMA (no de este .env), Claude Code la usará
# para autenticarse en vez de la suscripción Max, generando cobros de API.
# Verifica con `echo $ANTHROPIC_API_KEY` en una terminal nueva: debe salir
# vacío. Esta clave vive únicamente aquí, cargada por la aplicación en
# tiempo de ejecución. Cada llamada real consume API de pago (no la
# suscripción Max) — ver scripts/run_agent_demo.py antes de definirla.
ANTHROPIC_API_KEY=

# --- Control de gastos de la API de Anthropic (opcional) ---
# La API de Anthropic no expone un endpoint de saldo real — estos dos
# valores, declarados por vos a partir de lo que muestra la consola
# (Billing -> Credit balance), le permiten a scripts/run_daily_cycle.py
# estimar cuánto queda sumando el gasto que SÍ queda registrado en
# llamadas_ia desde esa fecha. Es una ESTIMACIÓN, no la cifra exacta de la
# consola (ver app/config.py::anthropic_saldo_declarado_usd sobre por qué
# puede divergir). Si los dejas vacíos, el reporte de cada corrida
# simplemente omite el saldo restante estimado. Recalibrá ambos cada vez
# que revises el saldo real en la consola.
# ANTHROPIC_SALDO_DECLARADO_USD=2.26
# ANTHROPIC_SALDO_DECLARADO_EN=2026-10-02T00:00:00+00:00

# --- Telegram (avisos salientes, Paso 11a; ver README "Avisos por Telegram") ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Parámetros operativos de paper trading ---
PAPER_CAPITAL_USD=1000
MAX_OPEN_POSITIONS=4
